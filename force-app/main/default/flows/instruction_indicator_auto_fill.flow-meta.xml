        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>check_for_service_request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rebooking</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_indicator_field</targetReference>
            </connector>
            <label>check for service request</label>
        </rules>
    </decisions>
    <formulas>
        <name>indicatorformula</name>
        <dataType>String</dataType>
        <expression>IF( ISPICKVAL( {!$Record.Sub_Type__c}, &apos;Rebooking to Origin/Specific OU&apos;) , &apos;SR&apos;,
IF( ISPICKVAL( {!$Record.Sub_Type__c}, &apos;Rebooking to UCG&apos;) , &apos;UCG&apos;,
IF( ISPICKVAL( {!$Record.Sub_Type__c}, &apos;Re-attempt&apos;) , &apos;NU&apos;,
IF( ISPICKVAL( {!$Record.Sub_Type__c}, &apos;Awaiting for OBN&apos;) , &apos;NU&apos;,&apos;&apos;))))</expression>
    </formulas>
    <interviewLabel>instruction indicator auto fill {!$Flow.CurrentDateTime}</interviewLabel>
